<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PreserveCompilationContext>true</PreserveCompilationContext>

    <!-- Self-contained like NINA.csproj: the compat System.Windows.dll can only win over the
         Microsoft.NETCore.App type-forwarder facade by overwriting the facade file in an
         app-local runtime (see CopySystemWindowsStub below). Framework-dependent test hosts
         always resolve the facade from the shared framework and no compat type loads. -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'=='' and $([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().Contains('Arm64'))">linux-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ASCOM.Tools" Version="3.1.0" />
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="FluentAssertions" Version="[7.0.0]" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NINA.Astrometry\NINA.Astrometry.csproj" />
    <ProjectReference Include="..\NINA.Core\NINA.Core.csproj" />
    <ProjectReference Include="..\NINA.Equipment\NINA.Equipment.csproj" />
    <ProjectReference Include="..\NINA.Image\NINA.Image.csproj" />
    <ProjectReference Include="..\NINA.Platesolving\NINA.PlateSolving.csproj" />
    <ProjectReference Include="..\NINA.Plugin\NINA.Plugin.csproj" />
    <ProjectReference Include="..\NINA.Profile\NINA.Profile.csproj" />
    <ProjectReference Include="..\NINA.Sequencer\NINA.Sequencer.csproj" />
    <ProjectReference Include="..\NINA.WPF.Base\NINA.WPF.Base.csproj" />
    <ProjectReference Include="..\NINA\NINA.csproj" />
    <ProjectReference Include="..\System.Windows.Compat\System.Windows.Compat.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Equipment\Camera\NikonCameraTest.cs" />
    <Compile Remove="Sequencer\SequenceItem\Utility\LoadImagingLayoutDataTemplateTest.cs" />
    <Compile Remove="SimpleSequencer\SimpleDSOContainerViewTest.cs" />
    <Compile Remove="SimpleSequencer\SimpleSequenceViewTest.cs" />
    <Compile Remove="View\AnchorableSequenceViewTest.cs" />
    <Compile Remove="View\DirectGuiderDetailViewTest.cs" />
    <Compile Remove="View\GuiderChartViewTest.cs" />
    <Compile Remove="View\HyperlinkBehaviorTest.cs" />
    <Compile Remove="ViewModel\DockManagerVMTest.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="AstrometryTest\HorizonData\commas.hrz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="AstrometryTest\HorizonData\empty.hrz">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="AstrometryTest\HorizonData\full360.hrz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="AstrometryTest\HorizonData\incomplete.hrz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="AstrometryTest\HorizonData\mixed.hrz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="AstrometryTest\HorizonData\mw4.hpts">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="AstrometryTest\HorizonData\partial.hrz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="AstrometryTest\HorizonData\tabs.hrz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Autofocus\TestImage_Jelly.xisf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Sequencer\Serialization\LegacySequences\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!-- The SDK's conflict resolution drops System.Windows.dll from copy-local because the
       simple name collides with a reserved framework assembly; copy it manually like NINA.csproj does. -->
  <Target Name="CopySystemWindowsStub" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)\..\System.Windows.Compat\bin\$(Configuration)\net10.0\System.Windows.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" />
  </Target>
</Project>
