<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="[7.0.0]" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Golden\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\*.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\umi\**\*.csv.gz" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\umi\README.md" CopyToOutputDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NINA.GuideEngine\NINA.GuideEngine.csproj" />
  </ItemGroup>
</Project>
